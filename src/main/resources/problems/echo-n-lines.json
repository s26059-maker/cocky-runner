{
  "id": "echo-n-lines",
  "title": "Echo N Lines",
  "description": "첫 줄에 정수 N이 주어지고, 이후 N개의 줄이 주어진다. 입력받은 N개의 줄을 그대로 출력한다.",
  "timeLimitMs": 2000,
  "testCases": [
    { "input": "2\nhello\nworld", "expectedOutput": "hello\nworld", "sample": true },
    { "input": "1\nfoo", "expectedOutput": "foo", "sample": false },
    { "input": "3\napple\nbanana\ncherry", "expectedOutput": "apple\nbanana\ncherry", "sample": false }
  ]
}
